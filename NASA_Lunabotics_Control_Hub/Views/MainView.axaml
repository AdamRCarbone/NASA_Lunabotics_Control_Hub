<UserControl x:Class="NASA_Lunabotics_Control_Hub.Views.MainView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NASA_Lunabotics_Control_Hub.ViewModels"
             xmlns:telemetry="clr-namespace:NASA_Lunabotics_Control_Hub.Controls.Telemetry"
             xmlns:cameras="clr-namespace:NASA_Lunabotics_Control_Hub.Controls.Cameras"
             xmlns:sensors="clr-namespace:NASA_Lunabotics_Control_Hub.Controls.Sensors"
             xmlns:ctrl="clr-namespace:NASA_Lunabotics_Control_Hub.Controls.Controls"
             xmlns:converters="clr-namespace:NASA_Lunabotics_Control_Hub.Converters"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:DataType="vm:MainViewModel">
    <Design.DataContext><vm:MainViewModel /></Design.DataContext>
    <Grid Background="#121212">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Background="#1A1A1A" Padding="16,12" BorderBrush="#00643C" BorderThickness="0,0,0,2">
            <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#00643C" Padding="12,10" CornerRadius="7"><TextBlock Text="OCTANE" Foreground="Black" FontSize="16" FontWeight="Bold" FontFamily="Arial Rounded MT Bold"/></Border>
                    <Border Background="#1A1F16" BorderBrush="#333333" BorderThickness="1.5" Padding="12,10" CornerRadius="7" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="10" Height="10" Background="#DC2626" CornerRadius="5"/><TextBlock Text="OFFLINE" Foreground="#DC2626" FontSize="13" FontWeight="Bold" FontFamily="Arial Rounded MT Bold" VerticalAlignment="Center"/></StackPanel></Border>
                </StackPanel>

                <!-- Mode Selection with LED indicators -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Width="110" Height="48" Classes="btn-secondary" Background="#2D2D2D" Foreground="Gray"
                            Command="{Binding OnModeSelected}" CommandParameter="Standby">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Standby" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="12" Height="12" CornerRadius="6"
                                    Background="{Binding StandbyStatus, Converter={StaticResource ModeStateToBrush}}"/>
                        </Grid>
                    </Button>
                    <Button Width="110" Height="48" Classes="btn-primary"
                            Command="{Binding OnModeSelected}" CommandParameter="Manual">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Manual" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="12" Height="12" CornerRadius="6"
                                    Background="{Binding ManualStatus, Converter={StaticResource ModeStateToBrush}}"/>
                        </Grid>
                    </Button>
                    <Button Width="110" Height="48" Classes="btn-secondary" Background="#2D2D2D" Foreground="Gray"
                            Command="{Binding OnModeSelected}" CommandParameter="Autonomous">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Autonomous" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="12" Height="12" CornerRadius="6"
                                    Background="{Binding AutonomousStatus, Converter={StaticResource ModeStateToBrush}}"/>
                        </Grid>
                    </Button>
                    <Button Width="120" Height="48" Classes="btn-secondary" Background="#2D2D2D" Foreground="Gray"
                            Command="{Binding OnModeSelected}" CommandParameter="Fault Reset">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fault Reset" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="12" Height="12" CornerRadius="6"
                                    Background="{Binding FaultResetStatus, Converter={StaticResource ModeStateToBrush}}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Center"><Button Classes="btn-danger" Height="44"><TextBlock Text="E-Suggestion" TextAlignment="Center" VerticalAlignment="Center"/></Button></Border>
            </Grid>
        </Border>

        <!-- MIDDLE -->
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
            <!-- LEFT PANEL -->
            <Border Grid.Column="0" Margin="4" Classes="card-primary">
                <StackPanel Margin="16" Spacing="12">
                    <TextBlock Text="Driving Control" Classes="section-header"/>
                    <Border Classes="card-secondary" Padding="12">
                        <StackPanel Spacing="12">
                            <StackPanel>
                                <TextBlock Text="Forward / Backward" Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Slider Minimum="-100" Maximum="100" Value="0" Height="30" Background="#2D2D2D" Foreground="#00643C" VerticalAlignment="Center"/>
                                <TextBlock Text="0 %" Foreground="#C5D86D" FontSize="16" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Left / Right" Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Slider Minimum="-100" Maximum="100" Value="0" Height="30" Background="#2D2D2D" Foreground="#00643C" VerticalAlignment="Center"/>
                                <TextBlock Text="0 %" Foreground="#C5D86D" FontSize="16" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ctrl:KeyInputGrid/>
                    <TextBlock Text="Actuators" Classes="section-header" Margin="0,16,0,0"/>
                    <Border Classes="card-secondary" Padding="12">
                        <StackPanel Spacing="12">
                            <StackPanel>
                                <TextBlock Text="Linear Actuator" Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Slider Minimum="0" Maximum="100" Value="50" Height="30" Background="#2D2D2D" Foreground="#00643C" VerticalAlignment="Center"/>
                                <TextBlock Text="50.0 %" Foreground="#C5D86D" FontSize="16" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Bucket Pitch" Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Slider Minimum="0" Maximum="100" Value="50" Height="30" Background="#2D2D2D" Foreground="#00643C" VerticalAlignment="Center"/>
                                <TextBlock Text="50.0 %" Foreground="#C5D86D" FontSize="16" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CENTER VIEWPORT -->
            <Border Grid.Column="1" Margin="4" Classes="card-primary">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Viewport Header -->
                    <TextBlock Grid.Row="0" Text="{Binding ActiveViewport, Converter={StaticResource ViewportIdToDisplayName}}"
                               Classes="section-header" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Viewport Content -->
                    <Border Grid.Row="1" Background="#0F0F0F" BorderBrush="#333333" BorderThickness="1">
                        <Grid>
                            <!-- Single placeholder that shows what's active -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🗺️" FontSize="48"/>
                                <TextBlock Text="{Binding ActiveViewport, Converter={StaticResource ViewportIdToDisplayName}, StringFormat='{}{0} Feed'}"
                                           Foreground="#606060" FontSize="18" FontWeight="Bold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveViewport, Converter={StaticResource ViewportIdToDisplayName}, StringFormat='Waiting for {0}'}"
                                           Foreground="#404040" FontSize="14" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Viewport stats overlay -->
                    <Border Background="#1A1A1A80" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="10" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel Spacing="3">
                            <TextBlock Text="DISCONNECTED" Foreground="#DC2626" FontSize="10" FontFamily="Consolas" FontWeight="Bold"/>
                            <TextBlock Text="Coverage: -- m²" Foreground="#606060" FontSize="9" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL -->
            <Border Grid.Column="2" Margin="4" Classes="card-primary">
                <StackPanel Margin="16" Spacing="10">
                    <!-- 3D Map Widget -->
                    <TextBlock Text="3D Map" Classes="section-header"/>
                    <sensors:ViewportCard Label="3D Map" ViewportId="map" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=map}" Margin="0,0,0,4"/>

                    <TextBlock Text="Near Cameras" Classes="section-header" Margin="0,4,0,0"/>
                    <StackPanel Spacing="3">
                        <cameras:CameraStatusCard CameraName="Depth Camera" CameraType="Depth" StatusText="No Data" ViewportId="depth_cam" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=depth_cam}"/>
                        <cameras:CameraStatusCard CameraName="Left Side" CameraType="RGB" StatusText="No Data" ViewportId="left_side" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=left_side}"/>
                        <cameras:CameraStatusCard CameraName="Left Front" CameraType="RGB" StatusText="No Data" ViewportId="left_front" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=left_front}"/>
                        <cameras:CameraStatusCard CameraName="Right Side" CameraType="RGB" StatusText="No Data" ViewportId="right_side" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=right_side}"/>
                        <cameras:CameraStatusCard CameraName="Right Front" CameraType="RGB" StatusText="No Data" ViewportId="right_front" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=right_front}"/>
                        <cameras:CameraStatusCard CameraName="Back Rear" CameraType="RGB" StatusText="No Data" ViewportId="back_rear" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=back_rear}"/>
                    </StackPanel>
                    <TextBlock Text="Far Cameras (April Tags)" Classes="section-header"/>
                    <StackPanel Spacing="3">
                        <cameras:CameraStatusCard CameraName="Front" CameraType="AprilTag" StatusText="No Tag" ViewportId="far_front" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=far_front}"/>
                        <cameras:CameraStatusCard CameraName="Right" CameraType="AprilTag" StatusText="No Tag" ViewportId="far_right" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=far_right}"/>
                        <cameras:CameraStatusCard CameraName="Back" CameraType="AprilTag" StatusText="No Tag" ViewportId="far_back" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=far_back}"/>
                        <cameras:CameraStatusCard CameraName="Left" CameraType="AprilTag" StatusText="No Tag" ViewportId="far_left" IsActive="{Binding ActiveViewport, Converter={StaticResource ViewportIdToIsActive}, ConverterParameter=far_left}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BOTTOM TELEMETRY -->
        <Border Grid.Row="2" Background="#1A1A1A" Padding="16,12" BorderBrush="#00643C" BorderThickness="0,1,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <!-- Left: Power/Battery Telemetry -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <telemetry:DataCard Grid.Column="0" Label="Battery" Value="--" SubValue="--" Unit="V"/>
                    <telemetry:DataCard Grid.Column="2" Label="Current" Value="--" SubValue="--" Unit="A"/>
                    <telemetry:DataCard Grid.Column="4" Label="Power" Value="--" SubValue="--" Unit="W"/>
                    <telemetry:DataCard Grid.Column="6" Label="Temp" Value="--" SubValue="--" Unit="°C"/>
                </Grid>
                <!-- Center: Motor Side Cards with full wheel telemetry -->
                <Grid Grid.Column="2" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <telemetry:MotorSideCard Grid.Column="0" SideName="LEFT"
                        W1Name="W1" W1AngularVel="--" W1Position="--" W1Torque="--" W1Current="--" W1Voltage="--"
                        W2Name="W2" W2AngularVel="--" W2Position="--" W2Torque="--" W2Current="--" W2Voltage="--"
                        W3Name="W3" W3AngularVel="--" W3Position="--" W3Torque="--" W3Current="--" W3Voltage="--"/>
                    <Border Grid.Column="2" Background="#0D1F16" BorderBrush="#00643C" BorderThickness="1.5" CornerRadius="8" Padding="16,12" VerticalAlignment="Center">
                        <TextBlock Text="Latency: -- ms" Foreground="#606060" FontSize="13" FontWeight="Bold" FontFamily="Consolas"/>
                    </Border>
                    <telemetry:MotorSideCard Grid.Column="4" SideName="RIGHT"
                        W1Name="W4" W1AngularVel="--" W1Position="--" W1Torque="--" W1Current="--" W1Voltage="--"
                        W2Name="W5" W2AngularVel="--" W2Position="--" W2Torque="--" W2Current="--" W2Voltage="--"
                        W3Name="W6" W3AngularVel="--" W3Position="--" W3Torque="--" W3Current="--" W3Voltage="--"/>
                </Grid>
                <!-- Right: IMU + System Status -->
                <Grid Grid.Column="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <telemetry:DataCard Grid.Column="0" Label="Roll" Value="--" SubValue="--" Unit="°"/>
                    <telemetry:DataCard Grid.Column="2" Label="Pitch" Value="--" SubValue="--" Unit="°"/>
                    <telemetry:DataCard Grid.Column="4" Label="Yaw" Value="--" SubValue="--" Unit="°"/>
                    <Border Grid.Column="6" Background="#0D1F16" BorderBrush="#DC2626" BorderThickness="1.5" Padding="14,10" CornerRadius="8">
                        <TextBlock Text="NO DATA" Foreground="#606060" FontSize="12" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
