<UserControl x:Class="NASA_Lunabotics_Control_Hub.Views.MainView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NASA_Lunabotics_Control_Hub.ViewModels"
             xmlns:controls="clr-namespace:NASA_Lunabotics_Control_Hub.Controls"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:DataType="vm:MainViewModel">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <!-- Glassmorphism Background -->
        <Style Selector="Border.glass-panel">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect">
                <BatchEffect>
                    <BatchEffect.Shaders>
                        <ShaderEffect Source="assets:///blur.hlsl" />
                    </ShaderEffect.Shaders>
                </BatchEffect>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style Selector="Button.primary-btn">
            <Setter Property="Background" Value="#FF6B44" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Emergency Stop Button -->
        <Style Selector="Button.estop-btn">
            <Setter Property="Background" Value="#FF3B30" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!-- Status Badge -->
        <Style Selector="Border.status-badge">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="BorderBrush" Value="#40FF6B44" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- Data Text -->
        <Style Selector="TextBlock.data-value">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF6B44" />
        </Style>

        <!-- Label Text -->
        <Style Selector="TextBlock.data-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#808080" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Styles>

    <Grid Background="#0D0D0D">
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar: Controls -->
            <ColumnDefinition Width="300" />
            <!-- Center: 3D Point Cloud -->
            <ColumnDefinition Width="*" />
            <!-- Right Sidebar: Telemetry -->
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: CONTROLS -->
        <Border Grid.Column="0" Classes="glass-panel" Margin="8,8,4,8">
            <StackPanel Margin="20">
                <!-- Connection Status -->
                <Border Classes="status-badge" Padding="12,8" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" Fill="#FF6B44" />
                        <TextBlock Text="Connecting..." FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Mode Selection -->
                <TextBlock Text="OPERATION MODE" FontSize="11"
                           Foreground="#606060" Margin="0,0,0,12" />

                <StackPanel Spacing="8" Margin="0,0,0,24">
                    <Button Content="STANDBY" Classes="primary-btn" />
                    <Button Content="MANUAL" Classes="primary-btn" />
                    <Button Content="AUTONOMOUS" Classes="primary-btn" />
                    <Button Content="FAULT RESET" Classes="primary-btn" />
                </StackPanel>

                <!-- Emergency Stop -->
                <Border Background="#20FF3B30" CornerRadius="12" Padding="16" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="EMERGENCY STOP"
                                   Foreground="#FFA0A0"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <Button Content="🛑 ESTOP"
                                Classes="estop-btn"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- Manual Controls -->
                <TextBlock Text="MANUAL CONTROL" FontSize="11"
                           Foreground="#606060" Margin="0,0,0,12" />

                <Border Classes="glass-panel" Padding="16" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- WASD -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="WASD"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#404040" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Move"
                                   FontSize="11"
                                   Foreground="#606060"
                                   Margin="0,4,0,0" />

                        <!-- Arrows -->
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="←↑↓→"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#404040" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="Rotate"
                                   FontSize="11"
                                   Foreground="#606060"
                                   Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <!-- Joystick Section (placeholder for future) -->
                <TextBlock Text="JOYSTICK" FontSize="11"
                           Foreground="#606060"
                           Margin="0,24,0,12" />
                <Border Classes="glass-panel" Padding="16" CornerRadius="8" Height="150">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🕹️" FontSize="48" />
                        <TextBlock Text="Connect USB Controller"
                                   Foreground="#606060"
                                   FontSize="11"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- CENTER: 3D POINT CLOUD VIEWER -->
        <Border Grid.Column="1" Classes="glass-panel" Margin="4,8,4,8">
            <Grid>
                <!-- Camera selector overlay -->
                <Border Background="#80000000" Padding="16" CornerRadius="8"
                        HorizontalAlignment="Top" VerticalAlignment="Top"
                        Margin="16,16,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="CAMERA:" Foreground="White" FontWeight="SemiBold" />
                        <Border Background="#404040" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="Near RGB - Left Side" Foreground="White" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Point Cloud Placeholder -->
                <Border Background="#0A0A0A" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🖼️" FontSize="72" />
                        <TextBlock Text="3D Point Cloud Viewer"
                                   Foreground="#404040"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="Point cloud will appear here when depth camera is active"
                                   Foreground="#404040"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   MaxWidth="400"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Overlay Statistics -->
                <Border Background="#80000000" Padding="12" CornerRadius="8"
                        HorizontalAlignment="Bottom" VerticalAlignment="Bottom"
                        Margin="16,0,16,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="FPS: 30" Foreground="#80FF6B44" FontSize="14" />
                        <TextBlock Text="Points: 128,432" Foreground="#80FF6B44" FontSize="14" />
                        <TextBlock Text="Depth Range: 0.5-8.0m" Foreground="#80FF6B44" FontSize="14" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT SIDEBAR: TELEMETRY -->
        <Border Grid.Column="2" Classes="glass-panel" Margin="4,8,8,8">
            <StackPanel Margin="20">
                <!-- System State -->
                <TextBlock Text="SYSTEM STATUS" FontSize="11"
                           Foreground="#606060" Margin="0,0,0,12" />

                <Border Classes="glass-panel" Padding="16" CornerRadius="8" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Mode -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Classes="data-label" Text="MODE" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Classes="data-value"
                                   Text="MANUAL"
                                   Foreground="#FF6B44" />

                        <!-- Battery -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Classes="data-label" Text="BATTERY"
                                   Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Classes="data-value"
                                   Text="11.4 V"
                                   Margin="0,8,0,0" />

                        <!-- Connection -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Classes="data-label" Text="CONNECTION"
                                   Margin="0,8,0,0" />
                        <Border Grid.Row="2" Grid.Column="1"
                                Background="#20FF6B44"
                                CornerRadius="4"
                                Padding="8,2"
                                Margin="0,8,0,0">
                            <TextBlock Text="ONLINE"
                                       Foreground="#FF6B44"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Active Faults -->
                <TextBlock Text="FAULTS" FontSize="11"
                           Foreground="#606060" Margin="0,0,0,12" />

                <Border Classes="glass-panel" Padding="16" CornerRadius="8" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="No active faults"
                                   Foreground="#808080"
                                   FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- Telemetry History -->
                <TextBlock Text="TIMELINE" FontSize="11"
                           Foreground="#606060" Margin="0,0,0,12" />

                <ScrollViewer Height="200">
                    <StackPanel Spacing="8">
                        <!-- Timeline entries -->
                        <Border Background="#1AFFFFFF" CornerRadius="4" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="14:32:15.234"
                                           Foreground="#404040"
                                           FontSize="10" />
                                <TextBlock Text="Connected to rover"
                                           Foreground="#808080"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Background="#1AFFFFFF" CornerRadius="4" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="14:31:48.567"
                                           Foreground="#404040"
                                           FontSize="10" />
                                <TextBlock Text="Mode changed: STANDBY → MANUAL"
                                           Foreground="#808080"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserPanel>