<Application x:Class="NASA_Lunabotics_Control_Hub.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <Color x:Key="PrimaryColor">#00643C</Color>
        <Color x:Key="AccentColor">#C5D86D</Color>
        <Color x:Key="SuccessColor">#4ade80</Color>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="/Resources/ROVERTheme.axaml"/>
    </Application.Styles>
</Application>
