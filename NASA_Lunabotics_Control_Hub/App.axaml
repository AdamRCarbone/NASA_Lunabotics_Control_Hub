<Application
    x:Class="NASA_Lunabotics_Control_Hub.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:NASA_Lunabotics_Control_Hub.Controls"
    RequestedThemeVariant="Default">
    <!--  "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options.  -->

    <Application.Resources>
        <Color x:Key="PrimaryColor">#48cbf0</Color>
    </Application.Resources>

    <Application.Styles>

        <FluentTheme>
            <FluentTheme.Palettes>
                <!--  Palette for Light theme variant  -->
                <ColorPaletteResources
                    x:Key="Light"
                    Accent="{StaticResource PrimaryColor}"
                    ErrorText="Red"
                    RegionColor="White" />
                <!--  Palette for Dark theme variant  -->
                <ColorPaletteResources
                    x:Key="Dark"
                    Accent="{StaticResource PrimaryColor}"
                    ErrorText="Yellow"
                    RegionColor="Black" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <StyleInclude Source="/Resources/Main_Theme.axaml" />



    </Application.Styles>
</Application>
