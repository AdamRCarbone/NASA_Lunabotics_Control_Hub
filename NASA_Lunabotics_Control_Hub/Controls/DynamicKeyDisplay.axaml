<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="100"
             x:Class="NASA_Lunabotics_Control_Hub.Controls.DynamicKeyDisplay">
  <Border Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="12">
    <StackPanel Spacing="6">
      <TextBlock Text="ACTIVE KEYS" Foreground="#606060" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
      <Border Name="KeysContainer"
              Background="#0F0F0F"
              BorderBrush="#2D2D2D"
              BorderThickness="1"
              CornerRadius="3"
              Padding="10,8"
              Height="60">
        <StackPanel Name="KeysWrapPanel" Orientation="Horizontal" Spacing="6">
          <!-- Key caps will be added dynamically here -->
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
