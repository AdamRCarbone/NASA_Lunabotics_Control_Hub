<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- CSU Green Theme Colors -->
    <!-- Primary: #00643C (Dark Green) -->
    <!-- Accent: #C5D86D (Lime) -->
    <!-- Success: #4ade80 (Green) -->
    <!-- Background: #121212, #1A1A1A, #1E1E1E -->
    <!-- Text: White, #E0E0E0, #A0A0A0, #606060 -->

    <!-- Font Families -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Card Styles -->
    <Style Selector="Border.card-primary">
        <Setter Property="Background" Value="#1E1E1E"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderBrush" Value="#00643C"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style Selector="Border.card-secondary">
        <Setter Property="Background" Value="#1A1A1A"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="#333333"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.card-telemetry">
        <Setter Property="Background" Value="#40000000"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="#00643C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- Button Styles -->
    <Style Selector="Button.btn-primary">
        <Setter Property="Background" Value="#00643C"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Arial Rounded MT Bold"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.btn-primary:pointerover">
        <Setter Property="Background" Value="#007A4A"/>
    </Style>

    <Style Selector="Button.btn-danger">
        <Setter Property="Background" Value="#DC2626"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="FontFamily" Value="Arial Rounded MT Bold"/>
    </Style>

    <Style Selector="Button.btn-danger:pointerover">
        <Setter Property="Background" Value="#EF4444"/>
    </Style>

    <Style Selector="Button.btn-secondary">
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Arial"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.btn-secondary:pointerover">
        <Setter Property="Background" Value="#3D3D3D"/>
    </Style>

    <!-- Text Block Styles -->
    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#00643C"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Arial Rounded MT Bold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style Selector="TextBlock.sub-header">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#A0A0A0"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style Selector="TextBlock.data-label">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="#606060"/>
        <Setter Property="FontFamily" Value="Arial"/>
    </Style>

    <Style Selector="TextBlock.data-value">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <Style Selector="TextBlock.data-value-accent">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="#C5D86D"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <Style Selector="TextBlock.data-value-success">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#4ade80"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <!-- Slider Styles -->
    <Style Selector="Slider.rover-slider">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="Foreground" Value="#00643C"/>
        <Setter Property="BorderBrush" Value="#00643C"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
    </Style>

    <!-- Status Indicator Styles -->
    <Style Selector="Border.status-online">
        <Setter Property="Background" Value="#0D1F16"/>
        <Setter Property="BorderBrush" Value="#00643C"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="Border.status-offline">
        <Setter Property="Background" Value="#1A1A1A"/>
        <Setter Property="BorderBrush" Value="#333333"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="Border.status-indicator-dot">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style Selector="Border.status-indicator-dot.active">
        <Setter Property="Background" Value="#4ade80"/>
    </Style>

    <Style Selector="Border.status-indicator-dot.inactive">
        <Setter Property="Background" Value="#606060"/>
    </Style>

    <!-- Sensor Card Style (for Viewport cards) -->
    <Style Selector="Border.sensor-card">
        <Setter Property="Background" Value="#1A1A1A"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="#333333"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.sensor-card:pointerover">
        <Setter Property="Background" Value="#252525"/>
        <Setter Property="BorderBrush" Value="#404040"/>
    </Style>

    <Style Selector="Border.sensor-card.active">
        <Setter Property="BorderBrush" Value="#C5D86D"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Border.sensor-card.active:pointerover">
        <Setter Property="BorderBrush" Value="#C5D86D"/>
        <Setter Property="Background" Value="#252525"/>
    </Style>

    <!-- Camera Status Card Styles -->
    <Style Selector="Border.camera-status">
        <Setter Property="Background" Value="#1A1A1A"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="#333333"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.camera-status:pointerover">
        <Setter Property="Background" Value="#252525"/>
        <Setter Property="BorderBrush" Value="#505050"/>
    </Style>

    <Style Selector="Border.camera-status.active">
        <Setter Property="BorderBrush" Value="#C5D86D"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="#1A1F16"/>
    </Style>

    <Style Selector="Border.camera-status.active:pointerover">
        <Setter Property="Background" Value="#252D22"/>
        <Setter Property="BorderBrush" Value="#C5D86D"/>
    </Style>

    <!-- Key Cap Style -->
    <Style Selector="Border.key-cap">
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="BorderBrush" Value="#4D4D4D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

    <Style Selector="Border.key-cap.active">
        <Setter Property="Background" Value="#00643C"/>
        <Setter Property="BorderBrush" Value="#007A4A"/>
    </Style>

    <Style Selector="TextBlock.key-cap-text">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

</Styles>
